# Supabase connection
# Find these in your project's API settings:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# New publishable key (format: sb_publishable_...). Preferred.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy anon key is also supported if you use it instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL used for auth email redirects (password reset, email change).
# Local dev: http://localhost:3000
# Production: your deployed origin, e.g. https://meridian.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000