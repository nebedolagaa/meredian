NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional legacy fallback (used only if NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

NEXT_PUBLIC_SITE_URL=https://meredian.fit

# Server-only. Required for admin operations like account hard delete
# and the plan share pages.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web push (background session reminders). Generate a key pair with
# `npx web-push generate-vapid-keys`; the private key is set as a secret on
# the send-reminders edge function, only the public key lives here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
